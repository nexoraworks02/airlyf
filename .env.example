# Copy to .env.local for local testing. On Vercel, add the same names under
# Project → Settings → Environment Variables, then redeploy (NEXT_PUBLIC_ values
# are built into the site, so a new key only takes effect after a redeploy).

# Booking form delivery — free key from https://web3forms.com (sent to your inbox).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional — leave empty until you have them; nothing loads while empty.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
